TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-botfather
TELEGRAM_OPEN_ACCESS=true
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_OWNER_USER_ID=123456789
GIPPO_AUTH_MODE=sms
GIPPO_PHONE=+375000000000
GIPPO_SESSION_PATH=/srv/bots/gippo-bot/private/gippo-session.json
GIPPO_CACHE_PATH=/srv/bots/gippo-bot/private/status-cache.json
SMS_FORWARDER_URL=http://127.0.0.1:18090
SMS_FORWARDER_TOKEN_FILE=/srv/bots/gippo-bot/private/sms-forwarder.token
# Alternatively use SMS_FORWARDER_TOKEN, but never configure both.
GIPPO_SMS_SENDER=GIPPO
GIPPO_SMS_TTL_SECONDS=300
GIPPO_SMS_COOLDOWN_SECONDS=900
# Optional legacy password mode: GIPPO_AUTH_MODE=password, GIPPO_LOGIN and GIPPO_PASSWORD.
GIPPO_BASE_URL=https://cabinet.gippo.by
GIPPO_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
